#!/bin/sh

focus_delay=2

key_delay=6

if [ "$#" -eq 0 ]; then
    printf '%s\n' "no arguments provided!"
    return 1
fi

conf_dir="${XDG_config_file_HOME:-${HOME}/.config}/type-decoded-qr"
config_file="$conf_dir/configrc"

if [ -r "$config_file" ]; then
    . "$config_file"
else
    if [ ! -d "$conf_dir" ]; then
        mkdir -p "$conf_dir"
    fi
    cat << __HEREDOC__ > "$config_file"
# vim: ft=sh
# type decoded qr config file

# delay for focusing, this is the time in SECONDS before the decoded qr text is typed
focus_delay=$focus_delay

# delay between key presses, this value is in milliseconds
key_delay=$key_delay
__HEREDOC__
fi

qr_file="$1"

type_text () {
    case "$XDG_SESSION_TYPE" in
        x11)
            xdotool type --delay "$key_delay" "$1"
            ;;
        wayland)
            wtype -d "$key_delay" "$1"
            ;;
    esac
}

decoded_qr="$(zbarimg -q "$qr_file")"
decoded_qr="${decoded_qr#*:}"
sleep "$focus_delay"
type_text "$decoded_qr"
notify-send -i nwg-clipman "clipboard selection typed"
